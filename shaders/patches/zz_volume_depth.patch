diff --git a/win32_30_nv8/deferred_lighting/deferred_lightingVS3.asm b/win32_30_nv8/deferred_lighting/deferred_lightingVS3.asm
--- a/win32_30_nv8/deferred_lighting/deferred_lightingVS3.asm
+++ b/win32_30_nv8/deferred_lighting/deferred_lightingVS3.asm
@@ -36,6 +36,7 @@
     def c0, -4, 0.159154937, 0.5, 1
     def c1, 6.28318548, -3.14159274, -1.57079637, 1.57079637
     def c2, 9.99999975e-005, -2, 9.99999975e-006, 0.662
+    def c229, 0.99999, 0, 0, 0 // FusionFix: zz_volume_depth.patch: just short of the far plane
     dcl_position v0
     dcl_position o0
     dcl_texcoord9 o10 // LogDepth Interpolator
@@ -125,6 +126,23 @@
     mad r1, r0.x, c8, r1
     mad r1, r0.z, c10, r1
     add r1, r1, c11
+    // --- FusionFix: zz_volume_depth.patch: the depth the light shaders wrote (oDepth), here per vertex: log2(w / near) /
+    // --- log2(far / near) (c227, the z-fighting fix's constants), as the scene's depth is. Between the vertices it comes out
+    // --- a little farther than the surface's own (log is concave), and the volume's back faces pass where they lie farther than
+    // --- the scene (ZFUNC GREATER), so no lit pixel is lost. An orthographic view keeps its own depth, as the light shaders did.
+    // --- b5 off (LightVolumeDepth): the volume at the far plane, every pixel the scene covers passes.
+    if b5
+      mul r2.x, r1.w, c227.x
+      log r2.x, r2.x
+      mul r2.x, r2.x, c227.y
+      mul r2.x, r2.x, r1.w
+      dp3 r2.y, c10.xyw, c10.xyw
+      slt r2.y, c229.y, r2.y // 0 for an orthographic view (vs_3_0 has no cmp)
+      add r2.x, r2.x, -r1.z
+      mad r1.z, r2.y, r2.x, r1.z
+    else
+      mul r1.z, r1.w, c229.x
+    endif
     add r0.xyz, r0, -c15
     mov o1.xyz, -r0
     mov o0, r1
