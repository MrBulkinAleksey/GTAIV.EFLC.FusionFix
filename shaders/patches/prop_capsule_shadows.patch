+    cmp r24.y, r20.w, r24.y, c138.y
+    mul r17.w, r17.w, r24.y
+    ret
     // --- FusionFix ped capsule shadows: the light the capsule r18 (x, y, foot, height; radius c154.x) leaves this pixel
     // --- (r15, the way to the light r16), into r17.w
     label l5
