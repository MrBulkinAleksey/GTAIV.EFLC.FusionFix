+            rcp r0.w, r0.w
+            mul r1.y, r0.w, c59.w
+            mul r1.z, r2.x, c59.w
+            mul r0.w, r0.w, r1.z
+            mad r3.z, r1.w, r1.y, r0.w
+        endif
+    endif
+    mov r2.x, c56.x
+    add r0.w, r2.x, c1.y
+    sge r0.w, -r0_abs.w, r0_abs.w
+    mad r1.y, r3.w, -c57.w, -r3.w
+    mad r2.z, r0.w, r1.y, r3.w
+    mov r2.x, r3.w
+    mov r2.y, r0.z
+    mad r1.yzw, r3.xwwz, c0.xzyy, c0.xyzz
