+    dcl_blendindices v2
+    dcl_texcoord v3
+    dcl_position o0
+    dcl_texcoord1 o1
+    dcl_texcoord o2.xyz
+    mul r0, c0.x, v2
+    mova a0, r0
+    mul r0, v1.y, c64[a0.y]
+    mul r1, v1.y, c65[a0.y]
+    mul r2, v1.y, c66[a0.y]
+    mad r0, c64[a0.x], v1.x, r0
+    mad r1, c65[a0.x], v1.x, r1
