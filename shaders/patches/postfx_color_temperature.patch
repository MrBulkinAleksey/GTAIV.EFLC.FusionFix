diff --git a/win32_30_nv8/rage_postfx/rage_postfxPS11.asm b/win32_30_nv8/rage_postfx/rage_postfxPS11.asm
index 21ff0ee..9df2dfb 100644
--- a/win32_30_nv8/rage_postfx/rage_postfxPS11.asm
+++ b/win32_30_nv8/rage_postfx/rage_postfxPS11.asm
@@ -222,6 +222,11 @@
     //   cmp r0.xyz, r0, r2, r1
     // endif
     
+    // FusionFix colour temperature (c187, ColorTemperature in shaders.ixx): the picture lit as if by light of
+    // another temperature, its brightness kept; c187.xyz is the factor per channel less 1, taken to the 1/2.2 power
+    // for this gamma space colour, so 0 leaves it as it is.
+    mad r0.xyz, r0, c187, r0
+    
     // Tone mapping
     if_ne -c217_abs.z, c217_abs.z
       // Assume that input is gamma 2.2
