+        mad r15.xyz, r30, r28.w, r31
+        mul r16.w, r15.z, r28.x
+        break_le r16.w, c155.z // behind the camera
+        mul r16.x, r15.x, r27.x
+        mad r16.x, r15.z, r27.z, r16.x
+        mul r16.y, r15.y, r27.y
+        mad r16.y, r15.z, r27.w, r16.y
+        rcp r16.z, r16.w
+        mul r16.xy, r16, r16.z
+        mad r18.xy, r16, c158.xy, c158.zz
+        mov r18.zw, c155.z
+        min r29.y, r18.x, r18.y
+        add r29.zw, c157.y, -r18.xyxy
+        min r29.z, r29.z, r29.w
+        min r29.y, r29.y, r29.z
+        break_lt r29.y, c155.z // left the screen
