+              mad r18.xy, r16, c158.xy, c158.zz
+              texldl r14, r18, s11
+              mul r14.x, r14.x, r28.z
+              exp r14.x, r14.x
+              mul r14.x, r14.x, r15.w
+              add r14.y, r16.w, -r14.x
+              if_gt r14.y, c155.z
+                mov r17.y, r17.z
+              else
+                mov r17.x, r17.z
+              endif
+            endrep
+            mul r28.w, r17.y, r17.y
+            mad r15.xyz, r30, r28.w, r31
+            mul r16.w, r15.z, r28.x
+            mul r16.x, r15.x, r27.x
+            mad r16.x, r15.z, r27.z, r16.x
+            mul r16.y, r15.y, r27.y
+            mad r16.y, r15.z, r27.w, r16.y
+            rcp r16.z, r16.w
+            mul r16.xy, r16, r16.z
+            mad r18.xy, r16, c158.xy, c158.zz
+            texldl r17, r18, s13
+            mul_sat r17.w, r29.y, c157.w // fade out near the screen edges
+            break
+          endif
+          endif
+          mov r17.x, c155.z // behind the scene
+        else
+          mov r17.x, c157.y // in front of the scene
+        endif
+        mov r31.w, r16.w
+      endrep
+      // Rays reflected back towards the camera would show the side of things the screen does
+      // not hold: a ped standing in front of a windscreen seen from ahead should show his
+      // front, the screen has his back, and the hit jumped between his back, his outline and
