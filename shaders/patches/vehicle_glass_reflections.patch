+    // --- use what it hits instead of the environment map. Without FusionFix's parameter
+    // --- texture (magic value missing) the environment map is kept as is.
+    mov r28, c155
+    texldl r27, r28, s9 // projection _11, _22, _31, _32
+    mov r28, c156
+    texldl r28, r28, s9 // projection _34, thickness, ray length, magic
+    add r29.x, r28.w, -c157.x
+    mul r29.x, r29.x, r29.x
+    if_lt r29.x, c157.y
+      // Steps grow with the square of the distance, dense next to the glass where a ped
+      // standing by it is, and each pixel starts up to one step later, so thin occluders are
+      // neither stepped over nor repeated as copies. A sample counts as a hit when it lands
+      // behind the scene by less than the thickness plus the depth the step itself covered.
