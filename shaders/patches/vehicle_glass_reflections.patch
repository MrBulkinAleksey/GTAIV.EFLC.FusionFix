+    // --- leaves the environment map as it is.
+    lrp r15.xyz, r17.w, r17, r4
+    mov r4.xyz, r15
     mul_sat r1.x, r5.z, c3.x
+    // --- FusionFix glass reflections: the game fades reflections that point below the horizon,
