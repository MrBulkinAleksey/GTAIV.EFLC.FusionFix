+      dp3 r31.y, r15, r16
+      dp3 r31.z, r15, c14
+      mul r31.w, r31.z, r28.x // view depth of the previous sample
+      // A ray short on screen takes fewer steps, about one per two pixels of it, 12 to 48: a
+      // window far away reflects over a few dozen pixels. r16 still holds texel 3, whose w is
+      // half the screen height; half its width is that times _22 / _11. r17.y takes the step
+      // in s, r17 being free until a hit.
+      mul r14.x, r31.x, r27.x
+      mad r14.x, r31.z, r27.z, r14.x
+      mul r14.y, r31.y, r27.y
+      mad r14.y, r31.z, r27.w, r14.y
+      rcp r14.w, r31.w
+      mul r14.xy, r14, r14.w // start, in clip space
+      add r18.xyz, r31, r30
+      mul r18.w, r18.z, r28.x
+      max r18.w, r18.w, c164.z // an end behind the camera just counts as long
+      mul r29.x, r18.x, r27.x
+      mad r29.x, r18.z, r27.z, r29.x
+      mul r29.y, r18.y, r27.y
+      mad r29.y, r18.z, r27.w, r29.y
+      rcp r18.w, r18.w
+      mul r29.xy, r29, r18.w
+      add r29.xy, r29, -r14
+      rcp r18.x, r27.x
+      mul r18.x, r18.x, r27.y
+      mul r18.x, r18.x, r16.w
+      mul r29.x, r29.x, r18.x
+      mul r29.y, r29.y, r16.w
+      dp2add r29.x, r29, r29, c155.z
+      max r29.x, r29.x, c164.z
+      rsq r29.y, r29.x
+      mul r29.x, r29.x, r29.y // length in pixels
+      mul r29.x, r29.x, c158.x
+      frc r29.y, r29.x
+      add r29.x, r29.x, -r29.y
+      add r29.x, r29.x, c157.y // floor(length / 2) + 1
+      max r29.x, r29.x, c164.x
+      min r29.x, r29.x, c164.y
+      rcp r17.y, r29.x
+      // s11 holds the game's log depth; linear = near * 2^(raw * log2(far / near)). The ray
+      // length in r28.z is no longer needed, so it takes log2(far / near); r15.w takes near.
+      mov r16, c162
+      texldl r16, r16, s9 // near, log2(far / near), step jitter flag, toward camera
+      mov r15.w, r16.x
+      mov r28.z, r16.y
+      dp2add r29.x, vPos, c159, c159.w // -1 only shifts the integer part, frc drops it
+      frc r29.x, r29.x
+      mul r29.x, r29.x, c159.z
+      frc r29.x, r29.x
+      add r29.x, r29.x, c159.w
+      mul r29.x, r29.x, r16.z // step jitter on or off (ScreenSpaceReflectionsGlassStepJitter)
+      mul r30.w, r29.x, r17.y
+      mov r17.w, c155.z
+      mov r17.x, c157.y // r17.x 1 while the previous sample was in front of the scene
+      rep i0
+        add r30.w, r30.w, r17.y
+        break_lt c157.y, r30.w // past the ray's end
