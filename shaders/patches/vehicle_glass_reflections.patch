+        mul r28.w, r30.w, r30.w
+        mad r14.xyz, r30, r28.w, r31
+        add r14.xyz, r14, -c15
+        dp3 r15.x, r14, c12
+        dp3 r15.y, r14, c13
+        dp3 r15.z, r14, c14
+        mul r16.w, r15.z, r28.x
+        break_le r16.w, c155.z // behind the camera
+        mul r16.x, r15.x, r27.x
+        mad r16.x, r15.z, r27.z, r16.x
+        mul r16.y, r15.y, r27.y
+        mad r16.y, r15.z, r27.w, r16.y
+        rcp r16.z, r16.w
+        mul r16.xy, r16, r16.z
+        mad r18.xy, r16, c158.xy, c158.zz
+        mov r18.zw, c155.z
+        min r29.y, r18.x, r18.y
+        add r29.zw, c157.y, -r18.xyxy
+        min r29.z, r29.z, r29.w
+        min r29.y, r29.y, r29.z
+        break_lt r29.y, c155.z // left the screen
+        texldl r14, r18, s11
+        add r14.y, r16.w, -r14.x
+        if_gt r14.y, c155.z
+          add r29.x, r16.w, -r31.w
+          abs r29.x, r29.x
+          add r29.x, r29.x, r28.y
+          if_lt r14.y, r29.x
+            texldl r17, r18, s13
+            mul_sat r17.w, r29.y, c157.w // fade out near the screen edges
+          endif
+          break // went behind the scene, a hit or not
+        endif
+        mov r31.w, r16.w
+      endrep
+      lrp r15.xyz, r17.w, r17, r4
+      mov r4.xyz, r15
+    endif
     mul_sat r1.x, r5.z, c3.x
     mul r4.xyz, r4, r1.x
     mul r4.xyz, r1.z, r4
