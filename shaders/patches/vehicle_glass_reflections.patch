+      add r15.xyz, v4, -c15
+      nrm r16.xyz, r15
+      nrm r14.xyz, r5
+      dp3 r16.w, r16, r14 // cosine between view and reflection
+      mad_sat r29.z, r16.w, c163.x, c163.y
+      add r29.w, r16.w, c163.z
+      mul_sat r29.w, r29.w, c163.w
+      mov r15, c162
+      texldl r15, r15, s9
+      lrp r28.w, r15.w, r29.w, r29.z
+      mul r17.w, r17.w, r28.w
+      // Debug view (texel 2 w > 0): bright green where the march hit, red where it missed,
+      // shown at full strength whatever the horizon fade would do; blue how much of the
+      // reflection the toward camera fade keeps. It takes the reflection's place in r17.
+      mov r16, c160
+      texldl r16, r16, s9
+      if_lt c155.z, r16.w
+        add r15.x, c157.y, -r17.w
+        mov r15.y, r17.w
+        mov r15.z, r28.w
+        mul r17.xyz, r15, c157.w
+        mov r17.w, c157.y
+      endif
+    endif
