+        mul r14.x, r14.x, r15.w
+        add r14.y, r16.w, -r14.x
+        if_gt r14.y, c155.z
+          add r29.x, r16.w, -r31.w
+          abs r29.x, r29.x
+          add r29.x, r29.x, r28.y
+          if_lt r14.y, r29.x
