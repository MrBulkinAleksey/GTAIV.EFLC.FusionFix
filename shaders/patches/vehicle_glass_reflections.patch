+    // --- FusionFix glass reflections: march the reflected ray through the opaque scene and
+    // --- use what it hits instead of the environment map. Without FusionFix's parameter
+    // --- texture (magic value missing) the environment map is kept as is.
+    mov r28, c155
+    texldl r27, r28, s9 // projection _11, _22, _31, _32
+    mov r28, c156
+    texldl r28, r28, s9 // projection _34, thickness, ray length, magic
+    add r29.x, r28.w, -c157.x
+    mul r29.x, r29.x, r29.x
+    mov r17, c155.z // no hit unless the march below finds one
+    if_lt r29.x, c157.y
+      // Steps grow with the square of the distance, dense next to the glass where a ped
+      // standing by it is. A hit is a crossing from in front of the scene to behind it by less
+      // than the thickness plus the depth the step itself covered. A ray that lands further
+      // behind, having passed behind a thin object such as a leg, carries on, and so can still
+      // hit what is behind it; stopping there broke the reflection up into angular patches.
+      // The ray is straight, so its start and direction go into view space once, here.
+      // gViewInverse's first two rows (c12, c13) are overwritten by this shader's own
+      // constants, so the camera's right and up axes come from the parameter texture.
