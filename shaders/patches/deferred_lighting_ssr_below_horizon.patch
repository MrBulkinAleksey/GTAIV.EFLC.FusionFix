diff --git a/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm b/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm
index 0c44c5dd..054f5117 100644
--- a/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm
+++ b/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm
@@ -501,6 +501,10 @@
       texldl r10, r10, s3
       add r11.xyz, r10, -r3
       mad r3.xyz, r11, r10.w, r3
+      // --- FusionFix SSR: the game fades reflections that point below the horizon, since its
+      // --- parabolic map only holds the sky. Keep that fade only where SSR found nothing.
+      add r11.w, -r0.z, c2.w
+      mad r0.z, r11.w, r10.w, r0.z
       mul r1.yzw, r0.z, r3.xxyz
       mul r0.xzw, r0.x, r1.yyzw
       mul r0.xzw, r4.z, r0
