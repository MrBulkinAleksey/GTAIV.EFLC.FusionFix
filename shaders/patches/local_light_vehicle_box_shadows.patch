+    add r24.xyz, r23, r12.y
+    mul r24.xyz, r24, r24
+    rcp r25.x, r24.x
+    rcp r25.y, r24.y
+    rcp r25.z, r24.z
+    mul r24.xyz, r21, r22
+    dp3 r24.x, r24, r25
+    mul r20.xyz, r22, r22
+    dp3 r24.y, r20, r25
+    rcp r24.y, r24.y
+    mul_sat r24.x, -r24.x, r24.y
+    mad r20.xyz, r22, r24.x, r21
+    call l2
+    mov r24.z, r20.w // how far the way to the light passes outside the box
+    mov r20.xyz, r21
+    call l2 // how far this pixel is from it
+    // the penumbra: the light's size times the part of the way where the box stands
+    mul r24.y, r12.x, r24.x
+    max r24.y, r24.y, c138.w
+    rcp r24.y, r24.y
+    mul r24.z, r24.z, r24.y
+    mad_sat r24.z, r24.z, c138.z, c138.z
+    mad r24.w, r24.z, c185.y, c185.x
+    mul r24.z, r24.z, r24.z
+    mul r24.z, r24.z, r24.w
+    add r20.w, r20.w, -r12.z
+    cmp r20.w, r17.x, r20.w, c138.y // only a car, ped or the player may be on the car
+    cmp r24.z, r20.w, r24.z, c138.y // a pixel on the car itself keeps its light
+    mul r17.w, r17.w, r24.z
