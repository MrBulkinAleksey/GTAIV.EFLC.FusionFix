+    def c138, 0, 1, 0.5, 0.05 // FusionFix vehicle box shadows: zero, one, a half, the narrowest penumbra
+    def c185, 3, -2, 31.875, 0.05 // FusionFix vehicle box shadows: the smoothstep's terms; the material ID's 255 and 0.4 over 8
+    def c186, 8, -2.4, 1.5, 0 // FusionFix vehicle box shadows: the category's 8, less vehicles' 2 and the 0.4, how far from it peds and the player lie
     dcl_texcoord v0
     dcl vPos.xy
     dcl_texcoord9 v9
@@ -61,6 +64,7 @@
     dcl_2d s1
     dcl_2d s2
     dcl_2d s13 // FusionFix GGX lights: the G-buffer's specular (_DEFERRED_GBUFFER_2_), bound by FusionFix during lighting
+    dcl_2d s11 // FusionFix vehicle box shadows: the material IDs (_STENCIL_BUFFER_), bound by FusionFix during lighting
     add r0.xy, c0.x, vPos
     mul r0.xy, r0, c77.zwzw
     texld r1, r0, s2
@@ -298,6 +302,45 @@
         add r31.w, c157.y, -r18.w
       endif
     endif
+    // --- FusionFix vehicle box shadows (c143-c149, VehicleBoxShadows in postfx.ixx): up to three cars near this light,
+    // --- each a box with rounded edges, shadow it as far as it reaches, also where its shadow map holds no cars or it has
+    // --- none. c143 + 2i: the box's centre and half length, c144 + 2i: its forward xy, half width and half height, the
+    // --- three less the rounding. c149: the light's size, the rounding, how near a pixel may be to a box and still take
+    // --- its shadow (the car's own surfaces do not), 1 while on for this light.
+    mov r12, c149
+    max r13.x, r26_abs.x, r26_abs.y
+    max r13.x, r13.x, r26_abs.z
+    cmp r13.x, -r13.x, c138.x, r12.w // off where this light adds nothing
+    if_lt c138.x, r13.x
+      add r13.xy, vPos, c138.z
+      mul r13.xy, r13, c77.zw
+      mov r13.zw, c138.x
