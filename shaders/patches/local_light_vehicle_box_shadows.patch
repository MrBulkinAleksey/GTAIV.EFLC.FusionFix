+    label l2
+    add r20.xyz, r20_abs, -r23
+    max r20.w, r20.x, r20.y
+    max r20.w, r20.w, r20.z
+    min r20.w, r20.w, c138.x
+    max r20.xyz, r20, c138.x
+    dp3 r20.x, r20, r20
+    rsq r20.x, r20.x
+    rcp r20.x, r20.x
+    add r20.w, r20.w, r20.x
+    add r20.w, r20.w, -r12.y
     ret
