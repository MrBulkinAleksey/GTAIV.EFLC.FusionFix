+    mad r22.x, r16.y, r19.y, r22.x
+    mul r22.y, r16.x, r19.y
+    mad r22.y, r16.y, -r19.x, r22.y
+    mov r22.z, r16.z
+    mov r23.x, r18.w
+    mov r23.yz, r19.xzww
