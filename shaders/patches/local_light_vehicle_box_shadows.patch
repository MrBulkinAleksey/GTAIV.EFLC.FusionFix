+      // pixel close to a box its own car's, or someone in it, which that box does not shadow; the ground never is
+      texldl r17, r13, s11
+      mad r17.x, r17.x, c185.z, c185.w
+      frc r17.x, r17.x
+      mad r17.x, r17.x, c186.x, c186.y
+      add r17.x, -r17_abs.x, c186.z // not below 0 on them
+      mov r17.w, c138.y // the light the boxes leave
+      mov r18, c143
+      mov r19, c144
+      call l3
+      mov r18, c145
+      mov r19, c146
+      call l3
+      mov r18, c147
+      mov r19, c148
+      call l3
+      mul r31.w, r31.w, r17.w
+    endif
     mul r26.xyz, r26, r31.w
     mov oC0, r26
     
