+    // --- none. c143 + 2i: the box's centre and half length, c144 + 2i: its forward xy, half width and half height, the
+    // --- three less the rounding. c149: the light's size, the rounding, how near a pixel may be to a box and still take
+    // --- its shadow (the car's own surfaces do not), 1 while on for this light.
+    mov r12, c149
+    max r13.x, r26_abs.x, r26_abs.y
