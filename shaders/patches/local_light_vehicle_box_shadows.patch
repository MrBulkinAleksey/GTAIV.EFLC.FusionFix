+    label l2
+    // the box narrows above its waist like a car's cabin, to 0.55 of its length and 0.75 of its width at the roof
+    add r25.w, r23.z, r12.y
+    rcp r25.w, r25.w
+    mul r25.w, r20.z, r25.w
+    mad_sat r25.w, r25.w, c187.z, c187.w
+    mul r25.xy, r25.w, c187.xy
+    add r25.xy, r25, c138.y
