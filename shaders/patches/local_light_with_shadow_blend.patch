@@ -756,6 +764,13 @@
     ret
     // --- FusionFix vehicle box shadows: how far r20.xyz lies outside the box of half edges r23.xyz rounded by r12.y, in r20.w
     label l2
+    // --- FusionFix: local_light_with_shadow_blend.patch: the skirt. Near the ground the box reaches out by r13.z (0.15 m) more, full at its foot, none from 0.3 m
+    // --- up: a box smaller and rounder than the car left a lit strip between its shadow and the contact shadow at the car
