diff --git a/win32_30_nv8/deferred_lighting/deferred_lightingPS14.asm b/win32_30_nv8/deferred_lighting/deferred_lightingPS14.asm
index c00941cc..2b42bc8d 100644
--- a/win32_30_nv8/deferred_lighting/deferred_lightingPS14.asm
+++ b/win32_30_nv8/deferred_lighting/deferred_lightingPS14.asm
@@ -681,6 +681,10 @@
       // --- FusionFix: zz_shape_groups.patch: the shapes in eight groups, each a sphere round them (centre, radius; c125-c128,
       // --- c116, c117, c119, c120) and its end (c115.y-w, c129.x-w, the last c115.x): a group's shapes are read only where the
       // --- way to the light passes within its sphere widened by the widest penumbra (r13.z), so most of the light's pixels read none
+      // --- FusionFix: zz_zz_shape_light_size.patch: the shapes soften by the light's own size (c142.y), not by c149.x, which a lamp
+      // --- of a pair on one post widens by half their spacing so that the cars' two shadows are one: a post's thin shadow went
+      // --- into that penumbra and was not seen at all
+      mov r12.x, c142.y
       add r13.z, c154.z, c154.w
       max r13.z, r13.z, r12.x
       max r13.z, r13.z, c138.w
