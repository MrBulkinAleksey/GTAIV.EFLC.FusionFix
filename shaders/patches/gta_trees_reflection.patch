diff --git a/win32_30_nv8/gta_trees/gta_treesPS7.asm b/win32_30_nv8/gta_trees/gta_treesPS7.asm
new file mode 100644
index 00000000..b6868f1c
--- /dev/null
+++ b/win32_30_nv8/gta_trees/gta_treesPS7.asm
@@ -0,0 +1,56 @@
+// FusionFix gta_trees_reflection.patch: the leaves in a forward pass (technique reflection_draw: a car's mirror, the
+// water's reflection). The tree shader had none: its draw technique's vertex shader puts every vertex at 0, the leaves
+// were only ever drawn into the G-buffer, and a car's mirror showed bare branches. The G-buffer pass's vertex shader
+// (VS0, with the wind), the leaf texture cut at the G-buffer pass's alpha, lit as gta_default's reflection shader lights
+// (the ambient by the normal's height, the sun wrapped round the leaf, which lets light through).
+//
+// Parameters:
+//
+//   sampler2D TextureSampler;
+//   float4 gDirectionalColour;
+//   float4 gDirectionalLight;
+//   float4 gLightAmbient0;
+//   float4 gLightAmbient1;
+//
+//
+// Registers:
+//
+//   Name               Reg   Size
+//   ------------------ ----- ----
+//   gDirectionalLight  c17      1
+//   gDirectionalColour c18      1
+//   gLightAmbient0     c37      1
+//   gLightAmbient1     c38      1
+//   TextureSampler     s0       1
+//
+
+    ps_3_0
+    def c219, 1.8395173895e+25, 3.9938258725e+24, 4.5435787456e+30, 1.2079192762e-42 // 862
+    def c0, -0.3125, 1, 0.5, 0
+    def c1, 9.99999975e-006, -0.5, 0.5, 0
+    dcl_texcoord v0.xy
+    dcl_texcoord1 v1.xyz
+    dcl_texcoord9 v9
+    dcl_2d s0
+    texld r0, v0, s0
+    add r1, r0.w, c0.x
+    texkill r1
+    add r1.xyz, c1.x, v1
+    nrm r2.xyz, r1
+    mad_sat r1.x, r2.z, c1.y, c1.z
+    mov r3.xyz, c38
+    mad r1.xyz, r3, r1.x, c37
+    mul r3.xyz, c18.w, c18
+    dp3 r1.w, r2, -c17
+    mad_sat r1.w, r1.w, c1.z, c1.z
+    mad r1.xyz, r3, r1.w, r1
+    mul oC0.xyz, r0, r1
+    mov oC0.w, c0.y
+    
+    // LogDepth Write
+    mul r19.x, v9.w, c209.x
+    log r19.x, r19.x
+    mul r19.x, r19.x, c209.y
+    rcp r19.y, v9.w
+    mul r19.y, r19.y, v9.z
+    cmp oDepth, -v9_abs.y, r19.y, r19.x
