diff --git a/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm b/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm
index 3bec465b..97b5dab2 100644
--- a/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm
+++ b/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm
@@ -79,6 +79,8 @@
     // -------------------------------------------------------------- Shadow Constants --------------------------------------------------------------
     def c110, -0.25, 1, -1, 0
     def c156, 255, 0.25, 16, -6 // FusionFix skin lighting: the material ID in steps; skin is a quarter step over a whole one
+    def c163, 0.252199411, 0.0004, 0, 0 // FusionFix specular sheen: the gloss world_no_specular_mark.patch writes, half a 10 bit step either way
+    def c158, 1, 0.0001, 0, 0 // FusionFix specular sheen
     def c111, 0.159154937, 0.5, 6.28318548, -3.14159274
     def c112, 3, 7.13800001, 0, 0
     def c113, 0.75, -0.5, 0.5, 0.0008
@@ -483,6 +485,35 @@
       dp3_sat r2.w, -c17, r1.yzww
       add r2.w, r2.w, c2.y
       texld r4, v0, s2
+      mov r18.x, r4.y // FusionFix specular sheen: the G-buffer gloss before it is decoded
+      // --- FusionFix specular sheen (c197.x, SpecularSheen in postfx.ixx): materials with no specular map
+      // --- (gta_default and its kind write specular 0, and gloss 258 / 1023 as world_no_specular_mark.patch
+      // --- marks them; peds and black texels of specular maps write 0.25) got neither the sun's highlight nor
+      // --- the sky's reflection. They take a specular intensity of their own here, before the lighting
+      // --- reads it, as if the G-buffer held one: SpecularSheen / 2 times the square of one
+      // --- less the albedo's saturation, faded out on dark albedo. The game's own sun highlight and sky
+      // --- reflection then follow from it.
+      texld r12, v0, s0
+      max r13.x, r12.x, r12.y
+      max r13.x, r13.x, r12.z // the brightest channel
+      min r13.y, r12.x, r12.y
+      min r13.y, r13.y, r12.z
+      add r13.y, r13.x, -r13.y
+      add r13.z, r13.x, c158.y
+      rcp r13.z, r13.z
+      mad_sat r13.y, r13.y, -r13.z, c158.x // 1 less the saturation
+      mul r13.y, r13.y, r13.y
+      mul_sat r13.x, r13.x, c6.x // smoothstep from black to a tenth
+      mad r13.z, r13.x, -c21.y, c21.x
+      mul r13.x, r13.x, r13.x
+      mul r13.x, r13.x, r13.z
+      mul r13.x, r13.x, r13.y
+      mul r13.x, r13.x, c197.x
+      mul r13.x, r13.x, c4.y
+      add r13.y, r18.x, -c163.x // the gloss they write, 258 / 1023
+      add r13.y, -r13_abs.y, c163.y
+      cmp r13.y, r13.y, r13.x, c158.z
+      cmp r4.x, -r4.x, r13.y, r4.x // specular 0
       mul r3.w, r4.y, r4.y
       mad r4.y, r3.w, c2.z, c2.y
       mul r3.w, r3.w, c0.x
