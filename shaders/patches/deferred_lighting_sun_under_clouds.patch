--- a/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm
+++ b/win32_30_nv8/deferred_lighting/deferred_lightingPS1.asm
@@ -81,6 +81,10 @@
     def c156, 255, 0.25, 16, -6 // FusionFix skin lighting: the material ID in steps; skin is a quarter step over a whole one
     def c163, 0.252199411, 0.0004, 0, 0 // FusionFix specular sheen: the gloss world_no_specular_mark.patch writes, half a 10 bit step either way
     def c158, 1, 0.0001, 0, 0 // FusionFix specular sheen
+    def c157, 0.05, 0, 0, 0 // FusionFix cloud shadows: the lowest sun height the plane is traced at
+    def c160, 0.08, 0.31, 6, 0.05 // FusionFix cloud shadows: the weather map's scale, offset and mip; the height's lowering
+    def c161, 0.159154937, 0.5, 6.28318548, -3.14159274 // FusionFix cloud shadows: angles into -pi..pi for sincos
+    def c162, 31.4159265, 25.1327412, 1.2, 0.4 // FusionFix cloud shadows: the morph's waves and phase rate; the compressor's power
     def c111, 0.159154937, 0.5, 6.28318548, -3.14159274
     def c112, 3, 7.13800001, 0, 0
     def c113, 0.75, -0.5, 0.5, 0.0008
@@ -113,6 +117,7 @@
     dcl_2d s3	// FusionFix SSR
     dcl_2d s9	// FusionFix contact shadows (occlusion, so an unbound sampler changes nothing)
     dcl_2d s8	// FusionFix screen space indirect light (black when off)
+    dcl_2d s12	// FusionFix cloud shadows: the cloud noise
     texld r1, v0, s1
     mul r2.xyz, r1.w, c0.yzww
     frc r2.xyz, r2
@@ -127,6 +132,7 @@
     mul r0.x, r19.x, c209.w
     
     mad r0.yzw, v1.xxyz, -r0.x, c15.xxyz
+    mov r14.xyz, r0.yzww // FusionFix cloud shadows: the world position
     dp3 r1.x, c14, r0.yzww
     add r1.xyz, -r1.x, -c54
     cmp r1.yzw, r1.xxyz, c3.x, c3.y
@@ -461,6 +467,67 @@
     add r28.w, c110.y, -r28.w // FusionFix: how much of the ambient indirect light leaves in place
     add r29.x, c110.y, -r29.x
     mul r0.y, r0.y, r29.x
+    // --- FusionFix cloud shadows (c197.y-w, c198, c199, s12; CloudShadows in postfx.ixx): the ray from
+    // --- the surface towards the sun meets the cloud deck, CloudShadowsHeight up or a third of the way up
+    // --- the volumetric clouds' layer, and the sun's light is dimmed by the clouds' coverage there, worked
+    // --- out as Clouds.fx's Density has it: the weather map's cover (c198.zw), the map read through the
+    // --- slow morph (c199.zw), saturate((n - t) / (1 - t)) with t = 1 - cover, less 0.05 for the
+    // --- height, its soft compressor taken as a power of 0.4; c199.x forces full cover (debug).
+    mov r15.x, c197.y
+    if_lt c158.z, r15.x
+      mov r15.xyz, -c17 // towards the sun
+      max r15.w, r15.z, c157.x
+      rcp r15.w, r15.w
+      add r16.x, -r14.z, c197.z
+      max r16.x, r16.x, c158.z
+      mul r16.x, r16.x, r15.w
+      mad r16.xy, r15.xy, r16.x, r14.xy // where the ray meets the deck
+      mul r16.xy, r16.xy, c197.w
+      add r16.xy, r16.xy, c198.xy // the wind
+      // the weather map's cover there
+      mad r17.xy, r16.xy, c160.x, c160.y
+      mov r17.z, c158.z
+      mov r17.w, c160.z
+      texldl r12, r17, s12
+      add r12.x, r12.x, r12.x
+      add r12.x, r12.x, -c158.x
+      mul r12.x, r12.x, c198.w
+      add r12.x, r12.x, c158.x
+      mul_sat r12.x, r12.x, c198.z
+      add r12.x, -r12.x, c158.x // t
+      add r12.y, -r12.x, c158.x
+      max r12.y, r12.y, c158.y
+      rcp r12.y, r12.y
+      // the morph
+      mul r12.z, r16.y, c162.x
+      add r12.z, r12.z, c199.z
+      mad r12.z, r12.z, c161.x, c161.y
+      frc r12.z, r12.z
+      mad r12.z, r12.z, c161.z, c161.w
+      sincos r13.xy, r12.z
+      mov r13.z, c199.z
+      mul r13.z, r13.z, c162.z
+      mul r12.w, r16.x, c162.y
+      add r12.w, r12.w, -r13.z
+      mad r12.w, r12.w, c161.x, c161.y
+      frc r12.w, r12.w
+      mad r12.w, r12.w, c161.z, c161.w
+      sincos r15.xy, r12.w
+      mad r16.x, r13.y, c199.w, r16.x // x by the sine across y
+      mad r16.y, r15.x, c199.w, r16.y // y by the cosine across x
+      mov r16.z, c158.z
+      mov r16.w, c199.y // the mip, for the softness of the shadow's edge
+      texldl r17, r16, s12
+      add r17.x, r17.x, -r12.x
+      mul r17.x, r17.x, r12.y
+      add_sat r17.x, r17.x, -c160.w
+      pow r17.x, r17.x, c162.w // coverage
+      add r12.z, -r17.x, c158.x
+      mad r17.x, r12.z, c199.x, r17.x
+      mul r17.x, r17.x, c197.y
+      add r17.x, -r17.x, c158.x
+      mul r0.y, r0.y, r17.x
+    endif
     // ----------------------------------------------------------------------------------------------------------------------------------------------
     mov r2.xyz, r31.xyz
     mad r1.xyz, v1, -r0.x, c1.w
